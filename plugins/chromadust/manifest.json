{
  "id": "io.github.nwh212.chromadust",
  "name": "ChromaDust",
  "version": "@version",
  "kind": "filter",
  "stage": "source",
  "overlap": "@overlap",
  "description": "Removes dust, hair and specks from scanned film. Put it above ChromaLab, on the film as scanned. Sensitivity sets how sure it must be that a mark is dust; tick Show detected spots to see what it finds.",
  "author": "nwh212",
  "homepage": "https://github.com/nwh212/ChromaLab-Plugin",
  "repository": "https://github.com/nwh212/ChromaLab-Plugin",
  "changelog": "https://github.com/nwh212/ChromaLab-Plugin/blob/main/CHANGELOG.md",
  "license": "MIT",
  "icon": "@icon",
  "params": {
    "image":       {"type": "choice", "label": "Image", "options": "@images", "default": "@image_default"},
    "sensitivity": {"type": "number", "label": "Sensitivity",     "min": 0, "max": 100, "default": 50},
    "maxSize":     {"type": "int",    "label": "Max spot size (px)", "min": "@min_size", "max": "@max_size", "default": 12},
    "protect":     {"type": "number", "label": "Protect detail",  "min": 0, "max": 100, "default": 50},
    "grain":       {"type": "bool",   "label": "Grain in fills",  "default": true},
    "show":        {"type": "bool",   "label": "Show detected spots", "default": false}
  }
}
